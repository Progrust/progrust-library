---
// 辞書サイドペイン（詳細ページ右・ui-design-spec「辞書サイドペイン（詳細ページ右）」）。
// デフォルト状態の静的枠を描画し、選択状態（種別ラベル・タイトル・タグ・本文・辞書リンク）は
// src/scripts/dict-pane.ts が data-* フックを介してクライアント側で差し替える（wikilink-ui R-10〜R-13）。
// expandable はデスクトップ右レール用: 拡大表示（右ドロワー・wikilink-ui R-21）のトリガーを
// ヘッダーに出す。モバイルシート内の複製は拡大対象外のため無指定（false）のまま使う。

interface Props {
  expandable?: boolean;
}

const { expandable = false } = Astro.props;
---

<div class="rounded border border-line bg-card" data-dict-pane>
  <div
    class="flex items-center justify-between gap-2 border-b border-line/70 py-2.5 pl-4 pr-3"
  >
    {
      expandable ? (
        <button
          type="button"
          data-dict-expand
          aria-label="辞書ペインを拡大表示"
          class="group -my-1 -ml-2 flex min-w-0 flex-1 cursor-pointer items-center gap-2 rounded px-2 py-1 text-left"
        >
          <span class="truncate font-mono text-xs text-accent">
            // dictionary pane
          </span>
          <svg
            class="h-3 w-3 shrink-0 text-sub opacity-0 transition-opacity group-hover:opacity-100 motion-reduce:transition-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 3h6v6" />
            <path d="M9 21H3v-6" />
            <path d="m21 3-7 7" />
            <path d="m3 21 7-7" />
          </svg>
        </button>
      ) : (
        <p class="font-mono text-xs text-accent">// dictionary pane</p>
      )
    }
    <div class="flex shrink-0 gap-1.5">
      <button
        type="button"
        disabled
        data-dict-pane-prev
        aria-label="前の辞書へ戻る"
        class="grid h-7 w-7 place-items-center rounded border border-line text-sub disabled:opacity-40"
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        disabled
        data-dict-pane-next
        aria-label="次の辞書へ進む"
        class="grid h-7 w-7 place-items-center rounded border border-line text-sub disabled:opacity-40"
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
      {
        expandable && (
          <button
            type="button"
            data-dict-expand
            aria-label="辞書ペインを拡大表示"
            class="grid h-7 w-7 place-items-center rounded border border-line text-sub transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none"
          >
            <svg
              class="h-3 w-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6" />
              <path d="M9 21H3v-6" />
              <path d="m21 3-7 7" />
              <path d="m3 21 7-7" />
            </svg>
          </button>
        )
      }
    </div>
  </div>
  {/* デフォルト状態（案内）。辞書リンククリック時に dict-pane.ts が隠す。 */}
  <div
    data-dict-pane-default
    class="flex max-h-[60vh] flex-col items-center gap-3 overflow-y-auto p-5 text-center"
  >
    <svg
      class="h-8 w-8 text-line"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 4.5v15A2.5 2.5 0 0 0 6.5 22H20v-2.5H6.5a1 1 0 0 1 0-2H20"
      ></path>
    </svg>
    <p class="text-sm text-sub">
      辞書リンクを押すと、ここに内容が表示されます。
    </p>
  </div>

  {
    /* 選択状態のコンテナ（初期は空・非表示）。dict-pane.ts が embed 内容を挿入する。
      relative 必須: 内容中の positioned 要素（脚注 sup・.code-playground 等）のオーバーフローは
      最近接の positioned 祖先に算入されるため、無指定だと positioned なスクロール祖先
      （モバイルの辞書ボトムシート等）の scrollHeight を膨張させ、下部に空白スクロール領域が生まれる。 */
  }
  <div
    data-dict-pane-content
    class="relative hidden max-h-[60vh] overflow-y-auto p-5"
  >
  </div>
</div>
